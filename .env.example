# Copy to .env (never commit .env). All values optional; default provider is the offline rule-based engine.
# LLM_PROVIDER: rule | openai | anthropic
LLM_PROVIDER=rule

# OpenAI-compatible endpoint (OpenAI / DeepSeek / Qwen / local vLLM ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Request timeout in seconds
LLM_TIMEOUT=60
