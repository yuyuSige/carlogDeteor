{
  "rules": [
    {
      "id": "grpc_fail",
      "kind": "GRPC_FAILURE",
      "category": "MODULE_COMMUNICATION",
      "severity": "HIGH",
      "score": 3.5,
      "any": ["UNAVAILABLE", "DEADLINE_EXCEEDED", "grpc", "gRPC", "StatusRuntimeException"]
    },
    {
      "id": "kanzi_fail",
      "kind": "KANZI_DISCONNECT",
      "category": "MODULE_COMMUNICATION",
      "severity": "HIGH",
      "score": 3.5,
      "any": ["Kanzi disconnect", "Kanzi connection failed", "IDataService died", "nativeapp binder"]
    },
    {
      "id": "timeout",
      "kind": "TIMEOUT",
      "category": "MODULE_COMMUNICATION",
      "severity": "HIGH",
      "score": 3.0,
      "any": ["timeout", "Timeout", "超时", "ReceiveDataTimeout", "timed out"]
    },
    {
      "id": "someip_vdbus",
      "kind": "BUS_FAILURE",
      "category": "MODULE_COMMUNICATION",
      "severity": "HIGH",
      "score": 3.0,
      "any": ["SOME/IP", "SomeIp", "VDBus", "connection failed", "connect failed", "重连失败",
              "retry failed"]
    }
  ]
}
